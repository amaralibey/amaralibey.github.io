---
import type { Paper } from '../data/papers';
import { Image } from 'astro:assets';

interface Props {
  paper: Paper;
}

const { paper } = Astro.props;
---

<article class="p-5 rounded-2xl border border-[var(--border-color)] bg-[var(--surface-color)]/50 hover:bg-[var(--card-hover)] transition-all duration-300 group shadow-sm hover:shadow-md flex flex-col md:flex-row gap-5 items-start">
  
  {paper.preview && (
    <div class="w-full md:w-52 h-40 md:h-28 shrink-0 overflow-hidden rounded-xl border border-[var(--border-color)] shadow-sm bg-[var(--surface-color)]">
      <Image 
        src={`/assets/${paper.preview}`} 
        alt={`Preview of ${paper.title.replace(/\{|\}/g, '')}`} 
        width={600}
        height={400}
        loading="eager"
        class="w-full h-full object-fill opacity-90 group-hover:opacity-100 transition-opacity duration-300" 
      />
    </div>
  )}

  <div class="flex-1 space-y-2 w-full">
    <div class="flex flex-wrap items-center gap-2 mb-1">
      <span class="px-2 py-0.5 text-xs font-semibold rounded-full bg-[var(--border-color)] text-[var(--text-color)]/80 tracking-wide">
        {paper.abbr} {paper.year}
      </span>
    </div>

    <h3 class="text-lg font-bold leading-tight group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors">
      <!-- Title -->
      {paper.url ? (
        <a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title.replace(/\{|\}/g, '')}</a>
      ) : (
        <span>{paper.title.replace(/\{|\}/g, '')}</span>
      )}
    </h3>

    <p class="text-[var(--text-color)]/80 text-sm leading-relaxed">
      {paper.authors.map((author, idx) => (
        <span class={author.includes('Amar Ali-bey') || author.includes('Amar Ali-Bey') ? 'font-bold text-[var(--text-color)]' : ''}>
          {author}{idx < paper.authors.length - 1 ? ', ' : ''}
        </span>
      ))}
    </p>

    <div class="flex items-center gap-2.5 pt-1.5">
      {paper.arxiv && (
        <a href={`https://arxiv.org/abs/${paper.arxiv}`} target="_blank" rel="noopener noreferrer" class="px-3 py-1 text-xs font-medium rounded-full border border-[var(--border-color)] hover:border-blue-500 hover:text-blue-500 dark:hover:border-blue-400 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 1.5L18.5 9H13V3.5z"/></svg>
          ArXiv
        </a>
      )}
      {paper.code && (
        <a href={paper.code} target="_blank" rel="noopener noreferrer" class="px-3 py-1 text-xs font-medium rounded-full border border-[var(--border-color)] hover:border-blue-500 hover:text-blue-500 dark:hover:border-blue-400 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          Code
        </a>
      )}
    </div>
  </div>
</article>
