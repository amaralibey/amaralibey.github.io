---
import { profile } from '../data/about';

const githubUsername = profile.socials.github.split('/').pop() || 'amaralibey';

const topRepos = [
  "OpenVPRLab",
  "NanoCLIP",
  "Bag-of-Queries",
  "MixVPR",
  "gsv-cities"
];
---

<section id="projects" class="scroll-mt-32 space-y-10 animate-fade-in" style="animation-delay: 450ms;">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <h2 class="text-3xl font-bold tracking-tight inline-block relative">
      Open Source Projects
      <div class="absolute -bottom-2 left-0 w-12 h-1 bg-[image:var(--primary-gradient)] rounded-full"></div>
    </h2>
    <a href={profile.socials.github} target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:text-blue-600 dark:text-blue-400 dark:hover:text-blue-300 font-medium inline-flex items-center gap-1 group">
      See all on GitHub
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </a>
  </div>

  <div class="grid md:grid-cols-2 gap-6" id="github-repos-grid">
    {topRepos.map(repo => (
      <a href={`https://github.com/${githubUsername}/${repo}`} target="_blank" rel="noopener noreferrer" class="block p-5 rounded-2xl border border-[var(--border-color)] overflow-hidden hover:shadow-lg transition-all duration-300 hover:-translate-y-1 bg-[var(--surface-color)]/30 group" data-repo={`${githubUsername}/${repo}`}>
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-5 h-5 text-[var(--text-color)]/70 group-hover:text-blue-500 transition-colors" fill="currentColor" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M2 2.5A2.5 2.5 0 014.5 0h8.75a.75.75 0 01.75.75v12.5a.75.75 0 01-.75.75h-2.5a.75.75 0 110-1.5h1.75v-2h-8a1 1 0 00-.714 1.7.75.75 0 01-1.072 1.05A2.495 2.495 0 012 11.5v-9zm10.5-1V9h-8c-.356 0-.694.074-1 .208V2.5a1 1 0 011-1h8zM5 12.25v3.25a.25.25 0 00.4.2l1.45-1.087a.25.25 0 01.3 0L8.6 15.7a.25.25 0 00.4-.2v-3.25a.25.25 0 00-.25-.25h-3.5a.25.25 0 00-.25.25z"/></svg>
          <h3 class="font-bold text-lg text-blue-600 dark:text-blue-400">{repo}</h3>
        </div>
        <p class="text-sm text-[var(--text-color)]/70 mb-4 h-10 line-clamp-2 repo-desc">Loading description...</p>
        <div class="flex items-center gap-4 text-xs font-medium text-[var(--text-color)]/60">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-blue-500 repo-lang-color"></span>
            <span class="repo-lang">...</span>
          </div>
          <div class="flex items-center gap-1 hover:text-[var(--text-color)] transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"></path></svg>
            <span class="repo-stars">...</span>
          </div>
          <div class="flex items-center gap-1 hover:text-[var(--text-color)] transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M5 3.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm0 2.122a2.25 2.25 0 10-1.5 0v.878A2.25 2.25 0 005.75 8.5h1.5v2.128a2.251 2.251 0 101.5 0V8.5h1.5a2.25 2.25 0 002.25-2.25v-.878a2.25 2.25 0 10-1.5 0v.878a.75.75 0 01-.75.75h-4.5A.75.75 0 015 6.25v-.878zm3.75 7.378a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm3-8.75a.75.75 0 100-1.5.75.75 0 000 1.5z"></path></svg>
            <span class="repo-forks">...</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<script>
  // Simple color map for languages
  const colors: Record<string, string> = {
    'Python': '#3572A5',
    'Jupyter Notebook': '#DA5B0B',
    'HTML': '#e34c26',
    'TypeScript': '#3178c6',
    'JavaScript': '#f1e05a',
    'C++': '#f34b7d',
    'C': '#555555'
  };

  document.querySelectorAll('#github-repos-grid a[data-repo]').forEach(card => {
    const repoName = card.getAttribute('data-repo');
    if (!repoName) return;

    fetch(`https://api.github.com/repos/${repoName}`)
      .then(res => res.json())
      .then(data => {
        if (!data || data.message === "Not Found") return;
        
        const descEl = card.querySelector('.repo-desc');
        const starsEl = card.querySelector('.repo-stars');
        const forksEl = card.querySelector('.repo-forks');
        const langEl = card.querySelector('.repo-lang');
        const langColorEl = card.querySelector('.repo-lang-color') as HTMLElement;
        
        if (descEl) descEl.textContent = data.description || 'No description provided';
        if (starsEl) starsEl.textContent = data.stargazers_count;
        if (forksEl) forksEl.textContent = data.forks_count;
        
        const lang = data.language || 'Unknown';
        if (langEl) langEl.textContent = lang;
        if (langColorEl) {
          langColorEl.style.backgroundColor = colors[lang] || '#8b5cf6';
        }
      })
      .catch(err => console.error("Failed to fetch repo", err));
  });
</script>
