---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PaperCard from '../components/PaperCard.astro';
import GithubRepos from '../components/GithubRepos.astro';
import { Image } from 'astro:assets';

import { profile } from '../data/about';
import { papers } from '../data/papers';

// Sort papers by year descending
const sortedPapers = papers.sort((a, b) => b.year - a.year);
---

<Layout>
  <Header />

  <main class="flex-1 w-full max-w-4xl mx-auto px-6 pt-32 pb-16 space-y-32">
    
    <!-- Hero Section -->
    <!-- Hero & Bio Section -->
    <section id="hero" class="flex flex-col-reverse md:flex-row items-center justify-between gap-12 animate-fade-in">
      <div class="space-y-8 flex-1 text-center md:text-left">
        <div class="space-y-4">
          <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight leading-tight text-[var(--text-color)]">
            <span class="bg-clip-text text-transparent bg-[image:var(--primary-gradient)] pb-1">{profile.title}</span>
          </h1>
          <h2 class="text-xl md:text-2xl font-medium text-[var(--text-color)]/80 leading-relaxed">
            {profile.subtitle}
          </h2>
        </div>
        
        <div class="space-y-4 text-[var(--text-color)]/80 leading-relaxed text-lg pt-2 md:pr-8">
          {profile.bio.map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 pt-4">
          <a href={profile.socials.github} target="_blank" rel="noopener noreferrer" class="px-5 py-2 text-sm rounded-full font-semibold border border-[var(--border-color)] hover:border-[var(--text-color)] transition-all hover:-translate-y-0.5 flex items-center gap-2">
            GitHub
          </a>
          <a href={profile.socials.scholar} target="_blank" rel="noopener noreferrer" class="px-5 py-2 text-sm rounded-full font-semibold border border-[var(--border-color)] hover:border-[var(--text-color)] transition-all hover:-translate-y-0.5 flex items-center gap-2">
            Scholar
          </a>
        </div>
      </div>
      
      <div class="shrink-0 flex flex-col items-center gap-4">
        <div class="w-48 h-48 md:w-64 md:h-64 rounded-2xl overflow-hidden shadow-xl flex items-center justify-center bg-[var(--surface-color)] border border-[var(--border-color)] relative group">
          <div class="absolute inset-0 bg-[image:var(--primary-gradient)] opacity-20 group-hover:opacity-40 transition-opacity mix-blend-overlay"></div>
          <Image 
            src={profile.image} 
            alt={profile.name}
            width={400}
            height={400}
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
        
        <div class="inline-flex items-center justify-center gap-2 text-sm font-medium text-[var(--text-color)]/70 cursor-default mb-2">
          <span class="text-base leading-none flex items-center justify-center pt-0.5">📍</span>
          <span class="leading-none font-semibold text-[var(--text-color)]/80">{profile.location} 🇨🇦</span>
        </div>
        
        <div class="flex justify-center gap-5">
          <a href={profile.socials.github} target="_blank" rel="noopener noreferrer" class="text-[var(--text-color)]/60 hover:text-[var(--text-color)] transition-colors hover:scale-110 transform" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
          </a>
          <a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer" class="text-[var(--text-color)]/60 hover:text-[var(--text-color)] transition-colors hover:scale-110 transform" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
          </a>
          <a href={profile.socials.twitter} target="_blank" rel="noopener noreferrer" class="text-[var(--text-color)]/60 hover:text-[var(--text-color)] transition-colors hover:scale-110 transform" aria-label="X (Twitter)">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
          </a>
          <a href={profile.socials.scholar} target="_blank" rel="noopener noreferrer" class="text-[var(--text-color)]/60 hover:text-[var(--text-color)] transition-colors hover:scale-110 transform" aria-label="Google Scholar">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
          </a>
          <a href={`mailto:${profile.email}`} class="text-[var(--text-color)]/60 hover:text-[var(--text-color)] transition-colors hover:scale-110 transform" aria-label="Email">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Expertise Section -->
    <section id="expertise" class="scroll-mt-32 space-y-8 animate-fade-in" style="animation-delay: 150ms;">
      <h2 class="text-3xl font-bold tracking-tight inline-block relative">
        Expertise
        <div class="absolute -bottom-2 left-0 w-12 h-1 bg-[image:var(--primary-gradient)] rounded-full"></div>
      </h2>
      
      <div class="flex flex-wrap gap-3">
        {profile.interests.map(interest => (
          <span class="px-5 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--surface-color)] text-[var(--text-color)]/90 font-medium shadow-sm cursor-default">
            {interest}
          </span>
        ))}
      </div>
    </section>

    <!-- Publications Section -->
    <section id="publications" class="scroll-mt-32 space-y-10 animate-fade-in" style="animation-delay: 600ms;">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <h2 class="text-3xl font-bold tracking-tight inline-block relative">
          Selected Publications
          <div class="absolute -bottom-2 left-0 w-12 h-1 bg-[image:var(--primary-gradient)] rounded-full"></div>
        </h2>
        <a href={profile.socials.scholar} target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:text-blue-600 dark:text-blue-400 dark:hover:text-blue-300 font-medium inline-flex items-center gap-1 group">
          See all on Google Scholar
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>

      <div class="grid gap-6">
        {sortedPapers.map(paper => (
          <PaperCard paper={paper} />
        ))}
      </div>
    </section>

    <GithubRepos />

  </main>

  <Footer />
</Layout>

<style>
  /* Basic enter animation utility used by elements above */
  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
