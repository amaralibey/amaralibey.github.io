---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PaperCard from '../components/PaperCard.astro';
import GithubRepos from '../components/GithubRepos.astro';

import { profile } from '../data/about';
import { papers } from '../data/papers';

// Sort papers by year descending
const sortedPapers = papers.sort((a, b) => b.year - a.year);
---

<Layout>
  <Header />

  <main class="flex-1 w-full max-w-4xl mx-auto px-6 pt-32 pb-16 space-y-32">
    
    <!-- Hero Section -->
    <section id="hero" class="flex flex-col-reverse md:flex-row items-center justify-between gap-12 animate-fade-in">
      <div class="space-y-6 flex-1 text-center md:text-left">
        <div class="space-y-2">
          <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-[var(--text-color)]">
            Hi, I'm <span class="bg-clip-text text-transparent bg-[image:var(--primary-gradient)] pb-1">{profile.name}</span>
          </h1>
          <p class="text-xl md:text-2xl font-medium text-[var(--text-color)]/80">
            {profile.title}
          </p>
        </div>
        
        <p class="text-lg text-[var(--text-color)]/70 max-w-2xl leading-relaxed">
          {profile.subtitle}
        </p>

        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 pt-4">
          <a href="#publications" class="px-6 py-3 rounded-full font-semibold bg-[var(--text-color)] text-[var(--bg-color)] hover:opacity-90 shadow-lg hover:shadow-xl transition-all hover:-translate-y-0.5">
            View Publications
          </a>
          <a href={profile.socials.scholar} target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-full font-semibold border-2 border-[var(--border-color)] hover:border-[var(--text-color)] transition-all hover:-translate-y-0.5 flex items-center gap-2">
            Google Scholar
          </a>
        </div>
      </div>
      
      <div class="w-48 h-48 md:w-64 md:h-64 rounded-full overflow-hidden border-4 border-[var(--bg-color)] shadow-2xl shrink-0 flex items-center justify-center bg-[var(--surface-color)] relative group">
        <div class="absolute inset-0 bg-[image:var(--primary-gradient)] opacity-20 group-hover:opacity-40 transition-opacity mix-blend-overlay"></div>
        <img 
          src={profile.image} 
          alt={`Profile picture of ${profile.name}`} 
          class="w-full h-full object-cover"
        />
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="scroll-mt-32 space-y-8 animate-fade-in" style="animation-delay: 150ms;">
      <h2 class="text-3xl font-bold tracking-tight inline-block relative">
        About Me
        <div class="absolute -bottom-2 left-0 w-1/2 h-1 bg-blue-500 rounded-full"></div>
      </h2>
      
      <div class="grid md:grid-cols-5 gap-10">
        <div class="md:col-span-3 space-y-6 text-[var(--text-color)]/80 leading-relaxed text-lg text-justify hyphens-none">
          {profile.bio.map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>
        
        <div class="md:col-span-2 p-6 rounded-2xl bg-[var(--surface-color)] border border-[var(--border-color)] space-y-4">
          <h3 class="font-bold text-[var(--text-color)] text-lg mb-2">My Interests</h3>
          <ul class="space-y-3">
            {profile.interests.map(interest => (
              <li class="flex items-start gap-3 text-[var(--text-color)]/80">
                <svg class="w-5 h-5 text-blue-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span>{interest}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <GithubRepos />

    <!-- Publications Section -->
    <section id="publications" class="scroll-mt-32 space-y-10 animate-fade-in" style="animation-delay: 600ms;">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <h2 class="text-3xl font-bold tracking-tight inline-block relative">
          Selected Publications
          <div class="absolute -bottom-2 left-0 w-1/2 h-1 bg-blue-500 rounded-full"></div>
        </h2>
        <a href={profile.socials.scholar} target="_blank" rel="noopener noreferrer" class="text-blue-500 hover:text-blue-600 dark:text-blue-400 dark:hover:text-blue-300 font-medium inline-flex items-center gap-1 group">
          See all on Google Scholar
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>

      <div class="grid gap-6">
        {sortedPapers.map(paper => (
          <PaperCard paper={paper} />
        ))}
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* Basic enter animation utility used by elements above */
  .animate-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
